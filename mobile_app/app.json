{
  "expo": {
    "name": "Vayu AI",
    "slug": "vayu-ai",
    "scheme": "vayuai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudheesh02.vayuai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vayu AI uses the microphone so you can talk to the fleet copilot.",
        "NSSpeechRecognitionUsageDescription": "Vayu AI converts your voice questions to text on the device."
      }
    },
    "android": {
      "package": "com.sudheesh02.vayuai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#06080C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06080C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#06080C",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vayu AI uses the microphone so you can talk to the fleet copilot.",
          "speechRecognitionPermission": "Vayu AI converts your voice questions to text on the device.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
